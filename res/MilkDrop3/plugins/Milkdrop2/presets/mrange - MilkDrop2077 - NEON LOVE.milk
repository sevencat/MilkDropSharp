per_frame_93=//Projektion waves
per_frame_94=n=0; loop (maxpts, gmegabuf(n+6)=0; n+=recsize); 
per_frame_95=s = 0; i = 0;
per_frame_96=loop (maxstrings,
per_frame_97=  ibase = s*recsize;
per_frame_98=  start = megabuf (ibase+1);
per_frame_99=  len   = megabuf (ibase+2);
per_frame_100=  p = start;  j=0;
per_frame_101=//  if (len==0, len=-1, 0);
per_frame_102=  loop (len+1, //ersten Pkt verdoppeln wegen waves
per_frame_103=    pbase = 5000 + (p%maxssize + s*maxssize)*recsize;
per_frame_104=    z    = megabuf (pbase+2)+dist0;
per_frame_105=    gmegabuf (i*recsize)   = megabuf(pbase  );    
per_frame_106=    gmegabuf (i*recsize+1) = megabuf(pbase+1);    
per_frame_107=    gmegabuf (i*recsize+2) = z;    
per_frame_108=    gmegabuf (i*recsize+3) = if (z>0, 0.007/z, 0) ;    //rad
per_frame_109=    gmegabuf (i*recsize+5) = 1; //a
per_frame_110=    gmegabuf (i*recsize+6) = (z>0.1)*(j>1) * (j<len-1); //mask
per_frame_111=    if (j>1, p += 1,0);  i += 1; j+=1;
per_frame_112=  );  
per_frame_113=  s+=1;
per_frame_114=);
