per_frame_4=
per_frame_5=
per_frame_6=
per_frame_7=dt = 1/fps;
per_frame_8=vol = sqrt (bass_att+mid_att+treb_att)/3; vol_ = vol_*0.9 + 0.1*vol; gf = 0.35*vol/maxssize;
per_frame_9=prog += vol*30*dt; 
per_frame_10=
per_frame_11=// Count sfree and pfree; pfree = len=0
per_frame_12=s = 0; sfree = maxstrings; pfree = maxpts;
per_frame_13=loop (maxstrings, ibase = s*recsize; if (megabuf(ibase+3) > 0, sfree -=1; pfree -=megabuf(ibase+2), 0); s+= 1);
per_frame_14=
per_frame_15=s = 0; loop (maxstrings, //NEW STRING ?
per_frame_16=  ibase = s*recsize;
per_frame_17=  if ((megabuf(ibase+3)==0) && (vol > vol_*1) && (rand(100) < 20),
per_frame_18=    sfree -= 1;
per_frame_19=    tht = rand(1)*(2.9 + (vol>vol_*1.7)); phi = (rand(1)-0.5)*4+pi/2;;
per_frame_20=    pbase = 5000 + (s*maxssize)*recsize; //erster Punkt startet bei 0
per_frame_21=    megabuf (ibase  ) = 0;//Age
per_frame_22=    megabuf (ibase+1) = 0;//start ind
per_frame_23=    megabuf (ibase+2) = 0;//len  
per_frame_24=    megabuf (ibase+3) = 1;// am Leben
per_frame_25=    megabuf (ibase+4) = sin(tht)*cos(phi);
per_frame_26=    megabuf (ibase+5) = sin(tht)*sin(phi);
per_frame_27=    megabuf (ibase+6) = -abs(cos(tht)); 
per_frame_28=  ,0); //END NEW STRING
per_frame_29=s+=1;);
per_frame_30=
per_frame_31=s = 0; loop (maxstrings, //GROW and SHRINK
per_frame_32=  ibase = s*recsize;
per_frame_33=  if (megabuf(ibase+3) > 0, //am Leben ?
per_frame_34=    megabuf(ibase  ) += dt*rand(2) ; //Age
per_frame_35=//EXPAND
per_frame_36=    age   = megabuf (ibase);
per_frame_37=    start = megabuf (ibase+1);
per_frame_38=    len   = megabuf (ibase+2);
per_frame_39=    newpts = int (5*vol*maxssize/40*(age < 0.7)) ; 
per_frame_40=    newpts = max (0, min (newpts, min (pfree,maxssize-start-len))); 
per_frame_41=    dx0 = megabuf (ibase+4);
per_frame_42=    dy0 = megabuf (ibase+5);
per_frame_43=    dz0 = megabuf (ibase+6);
per_frame_44=    p = start+len;
per_frame_45=    loop (newpts,
per_frame_46=      pbase  = 5000 + (p+s*maxssize)*recsize;
per_frame_47=k1 = if (s%3==0, p, (p-start-len)*16)+3+s/16;
per_frame_48=if (frame%5==0,k1 = 20*vol,0);
per_frame_49=//k1 = max(k1,p);
per_frame_50=      megabuf (pbase) = k1*dx0*gf; megabuf (pbase+1) = k1*dy0*gf; megabuf (pbase+2) = k1*dz0*gf;      
per_frame_51=      p+=1; ); 
per_frame_52=    megabuf(ibase +2) += newpts;  len   = megabuf (ibase+2);  pfree -= newpts;
per_frame_53=//SHRINK
per_frame_54=    ivol = if (vol<0.35,3, if (vol<0.5,2,1));
per_frame_55=    delpts = min ((megabuf(ibase)>.7),len) * (frame%ivol==0);
per_frame_56=    megabuf(ibase+1) = (megabuf(ibase+1)+delpts); 
per_frame_57=    megabuf(ibase+2) -= delpts;  pfree += delpts;
per_frame_58=    if (megabuf(ibase+2) <= 0, megabuf(ibase+3)=0, 0);
per_frame_59=  ,0);
per_frame_60=s+=1);
per_frame_61=
per_frame_62=//MOVE
per_frame_63=s = 0; loop (maxstrings,
per_frame_64=  ibase = s*recsize;  start = megabuf (ibase+1); len = megabuf (ibase+2);
per_frame_65=  if (len > 0, 
per_frame_66=    p=start; i=0;
per_frame_67=    loop (len,
per_frame_68=      pbase  = 5000 + (p%maxssize+s*maxssize)*recsize;
per_frame_69=      scale = pow(i/len,2)*0.005 ;
per_frame_70=      r1 = pow(megabuf(pbase),2)+pow(megabuf(pbase+1),2)+pow(megabuf(pbase+2),2);
per_frame_71=      scale *= min(sqrt(r1)*10,1) ; //##mit vol skalieren
per_frame_72=      p1 = 5000-int(3*p+prog);
per_frame_73=      megabuf (pbase)   += megabuf(90000+(p1+s*57)%5000)*scale;      
per_frame_74=      megabuf (pbase+1) += megabuf(90000+(p1+s*91)%5000)*scale;      
per_frame_75=      megabuf (pbase+2) += megabuf(90000+(p1+s*113)%5000)*scale;       
per_frame_76=      p+=1; i+=1;   ); 
per_frame_77=
per_frame_78=//STRAIGHTEN
per_frame_79=    p=start+1; smooth = 8;
per_frame_80=    sz = 1/(1.93+smooth);
per_frame_81=    loop (len-2,
per_frame_82=      pbase  =  5000 + (p    +s*maxssize)*recsize;
per_frame_83=      pbase1  = 5000 + ((p-1)+s*maxssize)*recsize;
per_frame_84=      pbase2  = 5000 + ((p+1)+s*maxssize)*recsize;
per_frame_85=      megabuf (pbase  ) = (smooth*megabuf(pbase  ) +megabuf(pbase1  )+megabuf(pbase2 ))*sz;      
per_frame_86=      megabuf (pbase+1) = (smooth*megabuf(pbase+1) +megabuf(pbase1+1)+megabuf(pbase2+1))*sz;      
per_frame_87=      megabuf (pbase+2) = (smooth*megabuf(pbase+2) +megabuf(pbase1+2)+megabuf(pbase2+2))*sz;      
per_frame_88=     p+=1; ); 
