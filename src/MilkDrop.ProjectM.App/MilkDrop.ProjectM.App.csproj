<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MilkDrop.ProjectM.App</RootNamespace>
    <AssemblyName>MilkDrop.ProjectM.App</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
<!--    <PublishAot>true</PublishAot>-->
    <InstructionSet>avx2</InstructionSet>
    <ApplicationIcon>milkdropsharp.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Native AOT 发布（P10）：日常 dotnet run/build 不受影响，只有显式 -p:PublishAot=true 时才生效。
    需要 MSVC 工具链（link.exe），见 projectMPlan.md 的 P10 小节。
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- NAudio 的 WASAPI 走 COM 互操作；NativeAOT 下需要内建 COM 支持（会有 IL3050 警告）。 -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 关掉用不到的基础设施，减小体积。 -->
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <!--
      Silk.NET 的窗口/输入后端是在运行时按 assembly 名发现的，裁剪会把它们丢掉。
      根住这两个 assembly（配合 Program.Main 里的 Window.PrioritizeGlfw）。
    -->
    <TrimmerRootAssembly Include="Silk.NET.Windowing.Glfw" />
    <TrimmerRootAssembly Include="Silk.NET.Input.Glfw" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageReference Include="ImGui.NET" Version="1.90.9.1" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
  </ItemGroup>
  <ItemGroup>
    <!--
      ANGLE 原生库。
      注意：Silk.NET.OpenGLES.ANGLE.Native 的 runtimes/win-x64 里放的是 x86 二进制（实测 machine=0x014C），
      在 x64 进程里会抛 BadImageFormatException，所以改用 Avalonia 的构建（真 x64，单 DLL：av_libglesv2.dll，
      EGL 入口带 "EGL_" 前缀）。详见 projectMIssue.md。
    -->
    <PackageReference Include="Avalonia.Angle.Windows.Natives" Version="2.1.27548.20260419" GeneratePathProperty="true" ExcludeAssets="all" />
    <Content Include="$(PkgAvalonia_Angle_Windows_Natives)\runtimes\win-x64\native\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="Always" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MilkDrop.ProjectM\MilkDrop.ProjectM.csproj" />
    <!-- ImGui GLES3 后端 / 截图 / EGL 上下文都在公共库里 -->
    <ProjectReference Include="..\MilkDrop.Rendering.Gles3\MilkDrop.Rendering.Gles3.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="MilkDrop.Rendering.Gles3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="milkdropsharp.ico" />
  </ItemGroup>
</Project>
